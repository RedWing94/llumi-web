{
  "sections": {
    "main": {
      "type": "main-article",
      "blocks": {
        "featured_image": {
          "type": "featured_image",
          "settings": {
            "image_height": "medium"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "blog_show_date": true,
            "blog_show_author": false
          }
        },
        "content": {
          "type": "content",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "featured_image",
        "title",
        "content",
        "share"
      ],
      "settings": {}
    },
    "blog_cta": {
      "type": "lumi-blog-cta",
      "settings": {
        "heading": "Find Your Daily Ritual",
        "text": "Not sure which Llumi product is right for you? Take our quick quiz to find your perfect match.",
        "button_label_1": "Take the Quiz",
        "button_link_1": "/pages/find-your-ritual",
        "button_label_2": "Shop All Products",
        "button_link_2": "/collections/all"
      }
    },
    "related_products": {
      "type": "featured-collection",
      "settings": {
        "title": "Shop Llumi",
        "heading_size": "h2",
        "collection": "all",
        "products_to_show": 4,
        "columns_desktop": 4,
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "enable_quick_add": false,
        "padding_top": 0,
        "padding_bottom": 60
      }
    }
  },
  "order": [
    "main",
    "blog_cta",
    "related_products"
  ]
}
