{%- comment -%}
  Lumi product picker for cross-linking related products.
  - Hydration products (tag "Hydration"): flavor pills only
  - Protein products (tag "Protein"): type row (Whey / Plant) + flavor pills
  - Pre-workout / energy products (product type "Pre-Workout Supplements"): flavor pills only
{%- endcomment -%}

{%- if product.tags contains 'Hydration' or product.tags contains 'Protein' or product.type == 'Pre-Workout Supplements' -%}

<style>
  .lumi-flavor-picker {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .lumi-flavor-picker__label {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.3rem;
    font-weight: 500;
    color: #1A1A1A;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
  }

  .lumi-flavor-picker__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lumi-flavor-picker__pill {
    display: inline-block;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    background: #F5ECEA;
    border: 1.5px solid #E4D6D2;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.4rem;
    color: #1A1A1A;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    cursor: pointer;
  }

  .lumi-flavor-picker__pill:hover {
    border-color: #B8827A;
  }

  .lumi-flavor-picker__pill--active {
    border-color: #B8827A;
    background: #F5ECEA;
    font-weight: 600;
    pointer-events: none;
  }

  .lumi-flavor-picker__row + .lumi-flavor-picker__row {
    margin-top: 0.75rem;
  }
</style>

{%- if product.tags contains 'Hydration' -%}
{%- comment -%} ── Hydration: flavor only ── {%- endcomment -%}
<div class="lumi-flavor-picker">
  <span class="lumi-flavor-picker__label">Choose your flavor</span>
  <div class="lumi-flavor-picker__options">
    {%- for col_product in collections.all.products -%}
      {%- if col_product.tags contains 'Hydration' -%}
        {%- assign is_current = false -%}
        {%- if col_product.handle == product.handle -%}
          {%- assign is_current = true -%}
        {%- endif -%}

        {%- assign flavor_name = col_product.title | remove: 'Llumi Hydrate ' | remove: 'Lumi Hydrate ' | remove: 'LLUMI Hydrate ' | remove: '(' | remove: ')' | strip -%}

        <a
          href="{{ col_product.url }}"
          class="lumi-flavor-picker__pill{% if is_current %} lumi-flavor-picker__pill--active{% endif %}"
          {% if is_current %}aria-current="true"{% endif %}
        >
          {{- flavor_name -}}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{%- if product.type == 'Pre-Workout Supplements' -%}
{%- comment -%} ── Pre-workout / energy: flavor only ── {%- endcomment -%}
<div class="lumi-flavor-picker">
  <span class="lumi-flavor-picker__label">Choose your flavor</span>
  <div class="lumi-flavor-picker__options">
    {%- for col_product in collections.all.products -%}
      {%- if col_product.type == 'Pre-Workout Supplements' -%}
        {%- assign is_current = false -%}
        {%- if col_product.handle == product.handle -%}
          {%- assign is_current = true -%}
        {%- endif -%}

        {%- assign flavor_name = col_product.title
          | remove: 'Llumi Pre-Workout'
          | remove: 'LLUMI Pre-Workout'
          | remove: 'Llumi Pre Workout'
          | remove: 'Flavor'
          | remove: '(' | remove: ')'
          | strip -%}

        <a
          href="{{ col_product.url }}"
          class="lumi-flavor-picker__pill{% if is_current %} lumi-flavor-picker__pill--active{% endif %}"
          {% if is_current %}aria-current="true"{% endif %}
        >
          {{- flavor_name -}}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{%- if product.tags contains 'Protein' -%}
{%- comment -%} ── Protein: type row + flavor row ── {%- endcomment -%}

{%- assign current_is_whey = false -%}
{%- assign current_is_plant = false -%}
{%- if product.tags contains 'Whey' -%}
  {%- assign current_is_whey = true -%}
{%- endif -%}
{%- if product.tags contains 'Plant' -%}
  {%- assign current_is_plant = true -%}
{%- endif -%}

{%- comment -%} Find the first product of each type to link the inactive type pill {%- endcomment -%}
{%- assign first_whey_url = '' -%}
{%- assign first_plant_url = '' -%}
{%- for col_product in collections.all.products -%}
  {%- if col_product.tags contains 'Protein' and col_product.tags contains 'Whey' and first_whey_url == '' -%}
    {%- assign first_whey_url = col_product.url -%}
  {%- endif -%}
  {%- if col_product.tags contains 'Protein' and col_product.tags contains 'Plant' and first_plant_url == '' -%}
    {%- assign first_plant_url = col_product.url -%}
  {%- endif -%}
{%- endfor -%}

<div class="lumi-flavor-picker">
  <div class="lumi-flavor-picker__row">
    <span class="lumi-flavor-picker__label">Protein type</span>
    <div class="lumi-flavor-picker__options">
      <a
        href="{{ first_whey_url }}"
        class="lumi-flavor-picker__pill{% if current_is_whey %} lumi-flavor-picker__pill--active{% endif %}"
        {% if current_is_whey %}aria-current="true"{% endif %}
      >
        100% Whey
      </a>
      <a
        href="{{ first_plant_url }}"
        class="lumi-flavor-picker__pill{% if current_is_plant %} lumi-flavor-picker__pill--active{% endif %}"
        {% if current_is_plant %}aria-current="true"{% endif %}
      >
        Plant Based
      </a>
    </div>
  </div>

  <div class="lumi-flavor-picker__row">
    <span class="lumi-flavor-picker__label">Choose your flavor</span>
    <div class="lumi-flavor-picker__options">
      {%- assign current_type_tag = '' -%}
      {%- if current_is_whey -%}{%- assign current_type_tag = 'Whey' -%}{%- endif -%}
      {%- if current_is_plant -%}{%- assign current_type_tag = 'Plant' -%}{%- endif -%}

      {%- for col_product in collections.all.products -%}
        {%- if col_product.tags contains 'Protein' and col_product.tags contains current_type_tag -%}
          {%- assign is_current = false -%}
          {%- if col_product.handle == product.handle -%}
            {%- assign is_current = true -%}
          {%- endif -%}

          {%- assign flavor_name = col_product.title
            | remove: 'Advanced 100% Whey Protein Isolate '
            | remove: 'Plant Protein '
            | remove: 'Llumi '
            | remove: 'LLUMI '
            | remove: '(' | remove: ')'
            | strip -%}

          <a
            href="{{ col_product.url }}"
            class="lumi-flavor-picker__pill{% if is_current %} lumi-flavor-picker__pill--active{% endif %}"
            {% if is_current %}aria-current="true"{% endif %}
          >
            {{- flavor_name -}}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{%- endif -%}
