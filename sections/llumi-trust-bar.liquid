{%- style -%}
  .llumi-trust-{{ section.id }} {
    padding: {{ section.settings.padding_vertical }}px 0;
  }
  .llumi-trust-{{ section.id }} .llumi-trust__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 22px;
    margin: 0;
    text-align: center;
  }
  .llumi-trust-{{ section.id }} .llumi-trust__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .llumi-trust-{{ section.id }} .llumi-trust__sep { opacity: 0.45; }
  .llumi-trust-{{ section.id }} .llumi-trust__icon {
    width: 18px; height: 18px; object-fit: contain;
  }
  @media (max-width: 749px) {
    .llumi-trust-{{ section.id }} .llumi-trust__item { font-size: 0.72rem; }
    .llumi-trust-{{ section.id }} .llumi-trust__sep { display: none; }
  }
{%- endstyle -%}

<div class="llumi-trust-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="llumi-trust__row">
      {%- for block in section.blocks -%}
        <span class="llumi-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <img
              class="llumi-trust__icon"
              src="{{ block.settings.icon | image_url: width: 36 }}"
              alt=""
              loading="lazy"
              width="18"
              height="18"
            >
          {%- endif -%}
          {{ block.settings.text | escape }}
        </span>
        {%- unless forloop.last -%}
          <span class="llumi-trust__sep" aria-hidden="true">·</span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "llumi-trust-bar-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Clean ingredients" },
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "text": "Clean ingredients" } },
        { "type": "item", "settings": { "text": "Sugar-free" } },
        { "type": "item", "settings": { "text": "Made in USA" } },
        { "type": "item", "settings": { "text": "30-day guarantee" } }
      ]
    }
  ]
}
{% endschema %}
