{{ 'section-lumi-blog-cta.css' | asset_url | stylesheet_tag }}

<div class="lumi-blog-cta page-width">
  <div class="lumi-blog-cta__card">
    <h2 class="lumi-blog-cta__heading">{{ section.settings.heading }}</h2>
    <p class="lumi-blog-cta__text">{{ section.settings.text }}</p>
    <div class="lumi-blog-cta__buttons">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="lumi-blog-cta__btn lumi-blog-cta__btn--primary">
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="lumi-blog-cta__btn lumi-blog-cta__btn--secondary">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Daily Ritual"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "Not sure which Llumi product is right for you? Take our quick quiz to find your perfect match."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Take the Quiz"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Blog CTA"
    }
  ]
}
{% endschema %}
